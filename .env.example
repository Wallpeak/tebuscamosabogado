# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Puerto HTTP (la mayoría de hostings lo define solo)
PORT=3000

# Archivo de la base de datos SQLite (se crea solo). En producción, en un disco persistente.
DATABASE_PATH=data/tebuscamos.db

# Días que se conservan los leads antes de borrarse automáticamente (0 = no borrar).
# Debe coincidir con el plazo indicado en la Política de Privacidad.
LEAD_RETENTION_DAYS=0

# Secreto para firmar la sesión del panel (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Contraseña del panel /dashboard (mínimo 12 caracteres; mejor 16+ y generada con un gestor de contraseñas).
# Cambiarla (o cambiar JWT_SECRET) cierra todas las sesiones abiertas.
ADMIN_PASSWORD=

# Número de WhatsApp del botón, con prefijo de país y sin "+" ni espacios (p. ej. 34600111222).
# Solo lo conoce el servidor: el botón pasa por /api/whatsapp y no aparece en el código de la web.
# Recomendado: un número de WhatsApp Business dedicado, no el personal (quien abre el chat lo ve).
WHATSAPP_NUMBER=

# Proxies de confianza delante del servidor (para saber la IP real y aplicar los límites por IP).
# 1 en Render, Railway, Fly.io o detrás de Nginx/Caddy. 0 si Node está expuesto directamente a internet.
TRUST_PROXY=1

# Interfaz de escucha (opcional). En `pnpm dev` es 127.0.0.1 (solo este equipo); en producción, todas.
# HOST=

# --- Avisos de nuevos leads (opcionales) ---
# Telegram: crea un bot con @BotFather y obtén tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook genérico (Slack, Discord, Make, n8n...). Recibe {"text": "...", "content": "..."}
NOTIFY_WEBHOOK_URL=

# --- Analítica (opcional, solo se carga si el visitante la acepta) ---
# URL completa del script (p. ej. https://tu-umami.example.com/script.js) e ID del sitio.
# Su origen se añade solo a la Content-Security-Policy del servidor.
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_WEBSITE_ID=
