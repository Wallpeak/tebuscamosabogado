# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Puerto HTTP (la mayoría de hostings lo define solo)
PORT=3000

# Archivo de la base de datos SQLite (se crea solo). En producción, en un disco persistente.
DATABASE_PATH=data/tebuscamos.db

# Días que se conservan los leads antes de borrarse automáticamente (0 = no borrar).
# Debe coincidir con el plazo indicado en la Política de Privacidad.
LEAD_RETENTION_DAYS=0

# Primer administrador del panel /dashboard. Se crea solo al arrancar.
# ADMIN_EMAIL es el usuario para entrar (por defecto "admin"). Pon un email real si quieres poder
# usar "He olvidado mi contraseña".
ADMIN_EMAIL=
# OBLIGATORIA, mínimo 6 caracteres. Si algún día se olvida, basta con cambiarla aquí y reiniciar la web.
ADMIN_PASSWORD=

# Dirección pública de la web (para los enlaces de los emails), p. ej. https://tebuscamosabogado.es
PUBLIC_URL=

# --- Emails (opcional): recuperar contraseña y avisos a abogados ---
# Opción A (recomendada con Hostinger): el buzón del hosting por SMTP.
#   Hostinger: SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  usuario = el email completo del buzón
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opción B: Resend (https://resend.com). Solo se usa si no hay SMTP configurado.
RESEND_API_KEY=
# Remitente que verá quien recibe el email, p. ej. "Te Buscamos Abogado <avisos@tudominio.es>".
# Con SMTP debe ser el mismo buzón de SMTP_USER (si se deja vacío, se usa ese).
EMAIL_FROM=
# Email que recibe un aviso por cada lead nuevo (y por registros de abogados y solicitudes aceptadas)
NOTIFY_EMAIL=

# --- Bandeja de abogados ---
# Horas que tiene un abogado para aceptar o rechazar una solicitud (por defecto 48)
OFERTA_HORAS=48
# Cuántos abogados pueden aceptar un mismo lead (por defecto 1; al llegar al tope se cierran las demás ofertas)
MAX_ABOGADOS_POR_LEAD=1
# 1 = cada lead nuevo se envía solo a los abogados que cubren su especialidad y provincia (y se reasigna si caduca o lo rechazan)
REPARTO_AUTOMATICO=0
# A cuántos abogados a la vez se envía cada lead en el reparto automático (por defecto 3)
REPARTO_ABOGADOS=3

# Proxies de confianza delante del servidor (para saber la IP real y aplicar los límites por IP).
# 1 en Render, Railway, Fly.io o detrás de Nginx/Caddy. 0 si Node está expuesto directamente a internet.
TRUST_PROXY=1

# Interfaz de escucha (opcional). En `pnpm dev` es 127.0.0.1 (solo este equipo); en producción, todas.
# HOST=

# --- Avisos de nuevos leads (opcionales) ---
# Telegram: crea un bot con @BotFather y obtén tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook genérico (Slack, Discord, Make, n8n...). Recibe {"text": "...", "content": "..."}
NOTIFY_WEBHOOK_URL=

# --- Analítica (opcional, solo se carga si el visitante la acepta) ---
# URL completa del script (p. ej. https://tu-umami.example.com/script.js) e ID del sitio.
# Su origen se añade solo a la Content-Security-Policy del servidor.
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_WEBSITE_ID=
