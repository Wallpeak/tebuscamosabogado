# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Puerto HTTP (la mayoría de hostings lo define solo)
PORT=3000

# Base de datos MySQL/MariaDB (cualquier proveedor):
# mysql://usuario:contraseña@host:3306/nombre_bd
DATABASE_URL=

# Secreto para firmar la sesión del panel (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Contraseña del panel /dashboard (mínimo 12 caracteres)
ADMIN_PASSWORD=

# --- Avisos de nuevos leads (opcionales) ---
# Telegram: crea un bot con @BotFather y obtén tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook genérico (Slack, Discord, Make, n8n...). Recibe {"text": "...", "content": "..."}
NOTIFY_WEBHOOK_URL=

# --- Analítica (opcional, solo se carga si el visitante la acepta) ---
# URL completa del script (p. ej. https://tu-umami.example.com/script.js) e ID del sitio
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_WEBSITE_ID=
